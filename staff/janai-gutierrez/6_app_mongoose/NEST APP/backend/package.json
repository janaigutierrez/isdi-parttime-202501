{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node .",
    "inspect": "node --inspect-brk .",
    "test": "mocha logics/*.test.js",
    "test:coverage": "c8 mocha logics/*.test.js",
    "test:coverage-html": "c8 --reporter=html mocha logics/*.test.js"
  },
  "c8": {
    "include": [
      "logics/*.js"
    ],
    "exclude": [
      "logics/*.test.js"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "dependencies": {
    "common": "file:../common",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jose": "^6.0.11",
    "mongoose": "^8.15.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "chai": "^5.0.0",
    "mocha": "^10.0.0",
    "supertest": "^7.0.0"
  }
}